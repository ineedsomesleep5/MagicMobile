{
  "about": "Smart pass (OnDeviceSmartPass), Stop for Removal (threatensViewer) and the skip modes (OnDeviceYieldPolicy). Contexts are patches over `context`; a prompt patch merges into its prompt, null removes it. passPrompt cases give the Situation fields and Settings patches over `settings`; yield scenarios start the mode on `start` (a patch) and evaluate each step (a patch over the base context, not the previous step), recording the pass when `record` is set; `pass` expects that step's prompt. Shared cases: ParityGoldenTests.swift (iOS), apps/web test/smartPass.test.ts; Android's OnDeviceSmartPass has no threat stops yet (docs/WEB_PARITY.md).",
  "context": {
    "matchID": "match",
    "seatID": "seat",
    "viewerID": "viewer",
    "activePlayerID": "viewer",
    "turn": 3,
    "phase": "running",
    "localHumanEnabled": true,
    "foreground": true,
    "emptyStack": true,
    "selfAuthority": true,
    "resyncRequired": false,
    "threatToMe": false,
    "prompt": {
      "id": "prompt",
      "revision": 10,
      "kind": "SELECT",
      "selectMode": "priority",
      "allowsBoolean": true,
      "submitted": false,
      "manaPlayerID": "viewer"
    }
  },
  "settings": {
    "enabled": true,
    "stops": [
      "mine.main1",
      "mine.main2",
      "theirs.declareAttackers",
      "theirs.end"
    ],
    "stopForOwnSpells": false,
    "stopForThreats": true
  },
  "modes": {
    "safeEndTurn": {
      "duration": 60,
      "passLimit": 64
    },
    "endTurnSkippingResponses": {
      "duration": 120,
      "passLimit": 256
    },
    "untilMyTurn": {
      "duration": 180,
      "passLimit": 256
    }
  },
  "steps": {
    "UPKEEP": "upkeep",
    "DRAW": "draw",
    "precombat-main": "main1",
    "PRECOMBAT_MAIN": "main1",
    "BEGIN_COMBAT": "beginCombat",
    "DECLARE_ATTACKERS": "declareAttackers",
    "DECLARE_BLOCKERS": "declareBlockers",
    "FIRST_COMBAT_DAMAGE": "combatDamage",
    "COMBAT_DAMAGE": "combatDamage",
    "END_COMBAT": "endCombat",
    "POSTCOMBAT_MAIN": "main2",
    "END_TURN": "end",
    "CLEANUP": "end",
    "UNTAP": null
  },
