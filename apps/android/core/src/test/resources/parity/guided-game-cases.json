{
  "about": "The guided first game: its words, its match and when each coach note shows. iOS ParityGoldenTests.testGuidedGameCasesOnBothPlatforms checks GuidedGameText, GuidedGameSetup, GuidedGameLaunch and GuidedGameCoach (GuidedGame.swift), and Android ParityGoldenTest.guidedGameCasesOnBothPlatforms checks the same names in core GuidedGame.kt. tips are in GuidedGameTip order. Each case lays its top-level keys over base (opponentStack: true puts one card on p2's stack), then runs GuidedGameCoach.advance with the note on screen (current) and the notes already shown; expect is the note shown after it and the one shown for the first time.",
  "title": "Guided first game",
  "subtitle": "A real game against an easy AI, with tips as each moment comes up.",
  "start": "Play a guided game",
  "gotIt": "Got it",
  "turnOff": "Turn off tips",
  "welcome": {
    "title": "Welcome to the tavern",
    "body": "New to Magic or to MagicMobile? Play a guided game against an easy AI and learn as you go.",
    "readHowToPlay": "Read How to Play",
    "skip": "I know Magic"
  },
  "tips": [
    {
      "id": "firstPlayer",
      "title": "Who goes first",
      "body": "Welcome to your guided game. I'll explain each moment the first time it comes up. Choose yourself to take the first turn.",
      "actionable": true
    },
    {
      "id": "mulligan",
      "title": "Your opening hand",
      "body": "These are your first seven cards. A good hand has two to five lands. Tap Keep, or Mulligan for a fresh seven.",
      "actionable": true
    },
    {
      "id": "attack",
      "title": "Attack",
      "body": "Tap each creature you want to send into combat, then Done Attacking. Creatures that arrived this turn can't attack yet.",
      "actionable": true
    },
    {
      "id": "block",
      "title": "Block",
      "body": "You're being attacked. Tap your creature, then the attacker it should block, and tap Done Blocking. Unblocked attackers hit you.",
      "actionable": true
    },
    {
      "id": "pay",
      "title": "Pay the cost",
      "body": "Tap your lands to pay for the spell. The tray shows how much mana is still owed.",
      "actionable": true
    },
    {
      "id": "target",
      "title": "Choose a target",
      "body": "This needs a target. Anything glowing red can be chosen: tap it.",
      "actionable": true
    },
    {
      "id": "opponentSpell",
      "title": "A spell on the stack",
      "body": "Your opponent's spell waits on the stack until everyone passes. You could answer with an instant; for now, tap the hourglass to let it resolve.",
      "actionable": true
    },
    {
      "id": "commander",
      "title": "Cast your commander",
      "body": "Your commander is ready in the command zone, and its medallion glows. Tap the medallion to cast it.",
      "actionable": true
    },
    {
      "id": "land",
      "title": "Play a land",
      "body": "Lands make the mana you cast spells with. Drag a land from your hand up onto the mat. You can play one each turn.",
      "actionable": true
    },
    {
      "id": "cast",
      "title": "Cast a spell",
      "body": "A green glow means a card can be played now. Drag it from your hand onto the mat to cast it.",
      "actionable": true
    },
    {
      "id": "pass",
      "title": "Pass with the hourglass",
      "body": "Nothing left to play? Tap the hourglass to move on. Skip jumps to your next turn and still stops when you're needed.",
      "actionable": true
    },
    {
      "id": "inspect",
      "title": "Read a card",
      "body": "Press and hold any card, yours or your opponent's, to read its full rules text.",
      "actionable": false
    },
    {
      "id": "basics",
      "title": "You know the basics",
      "body": "That's everything you need. Bring your opponent from 40 life to 0 to win, or leave from the game menu any time.",
      "actionable": false
    }
  ],
