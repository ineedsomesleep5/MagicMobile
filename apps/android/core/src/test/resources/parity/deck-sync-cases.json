              "Island"
            ]
          }
        ],
        "server": [
          {
            "id": "S1",
            "name": "Theirs",
            "revision": 2,
            "deleted": false
          },
          {
            "fork": true,
            "name": "Mine (this device)",
            "revision": 1,
            "deleted": false
          }
        ]
      }
    },
    {
