          {
            "fork": true,
            "name": "Mine (this device)",
            "revision": 1,
            "deleted": false
          }
        ]
      }
    },
    {
      "name": "a deck deleted here is deleted everywhere",
      "account": "A",
      "server": [
        {
          "id": "S1",
          "name": "Old",
          "revision": 1,
          "seq": 1,
          "deleted": false,
          "cards": [
            "Forest"
          ]
        }
      ],
      "local": [],
      "sync": {
        "account": "A",
        "cursor": 1,
        "entries": {},
        "tombstones": [
          {
            "id": "S1",
            "serverRevision": 1
          }
        ]
      },
      "expect": {
        "local": [],
        "server": [
          {
            "id": "S1",
            "name": "Old",
            "revision": 2,
            "deleted": true
