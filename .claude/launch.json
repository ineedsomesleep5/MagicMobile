{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-solo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "web-staged",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/web && ENGINE_DIR=.vercel-deploy/engine npx vite preview --outDir .vercel-deploy --port 5174 --strictPort --host 127.0.0.1"
      ],
      "port": 5174
    },
    {
      "name": "web-parity",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev",
        "--",
        "--port",
        "5181",
        "--strictPort"
      ],
      "port": 5181
    },
    {
      "name": "deck-helper",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "scripts/deck-helper/serve.py"
      ],
      "port": 8765
    }
  ]
}
